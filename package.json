{
  "name": "small-business-workflow",
  "version": "0.1.0",
  "description": "Self-hosted employee workflow panel for small businesses: leave, expenses, approvals, inventory and invoices on Cloudflare Workers, D1 and R2.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsr generate && tsc --noEmit -p .",
    "test": "vitest run",
    "check:dist": "node scripts/check-dist.mjs",
    "verify": "npm run typecheck && vitest run && vite build && node scripts/check-dist.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed": "node scripts/seed-dev.ts --apply",
    "db:reset": "rm -rf .wrangler/state/v3/d1 .wrangler/state/v3/r2 && wrangler d1 migrations apply DB --local && node scripts/seed-dev.ts --apply",
    "deploy": "npm run verify && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "fflate": "0.8.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
